generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum CooperativeCycleStatus {
  OPEN_FOR_APPLICATION
  APPLICATION_CLOSED
  IN_PROGRESS
  CLOSED
}

enum UserRole {
  STAFF
  TEACHER
  STUDENT
}

model User {
  id           Int         @id @default(autoincrement())
  loginId      String      @unique @map("login_id")
  passwordHash String      @map("password_hash")
  role         UserRole
  isActive     Boolean     @default(true) @map("is_active")
  sessions     AuthSession[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model CooperativeCycle {
  id                   Int                    @id @default(autoincrement())
  term                 Int
  academicYear         Int                    @map("academic_year")
  cohortYear           Int                    @map("cohort_year")
  applicationStartDate DateTime               @map("application_start_date") @db.Date
  applicationEndDate   DateTime               @map("application_end_date") @db.Date
  internshipStartDate  DateTime               @map("internship_start_date") @db.Date
  internshipEndDate    DateTime               @map("internship_end_date") @db.Date
  status               CooperativeCycleStatus @default(OPEN_FOR_APPLICATION)
  note                 String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@unique([term, academicYear], name: "term_academicYear")
  @@map("cooperative_cycles")
}

model Student {
  id         Int      @id @default(autoincrement())
  studentId  String   @unique @map("student_id")
  prefix     String
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  gender     String
  cohortYear Int      @map("cohort_year")
  classGroup Int      @map("class_group")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("students")
}

model Teacher {
  id        Int      @id @default(autoincrement())
  teacherId String   @unique @map("teacher_id")
  prefix    String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  gender    String
  phone     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teachers")
}

model Company {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String   @map("contact_person")
  phone         String?
  email         String?
  addressNo     String   @map("address_no")
  moo           String?
  soi           String?
  street        String?
  subdistrict   String
  district      String
  province      String
  postalCode    String   @map("postal_code")
  latitude      Float?
  longitude     Float?
  travelNote    String?  @map("travel_note")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model Staff {
  id        Int      @id @default(autoincrement())
  staffId   String   @unique @map("staff_id")
  prefix    String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  gender    String
  phone     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staffs")
}
