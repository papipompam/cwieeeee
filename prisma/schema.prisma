generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum CooperativeCycleStatus {
  OPEN_FOR_APPLICATION
  APPLICATION_CLOSED
  IN_PROGRESS
  CLOSED
}

enum UserRole {
  STAFF
  TEACHER
  STUDENT
}

enum CompanyApplicationStatus {
  SUBMITTED
  AWAITING_RESPONSE
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  CONFIRMED
}

enum CooperativeRequestStatus {
  DRAFT
  SUBMITTED
  STAFF_PROCESSING
  LETTER_READY
  DOCUMENT_UNDER_REVIEW
  RETURNED_FOR_REVISION
  PLACEMENT_CONFIRMED
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  WAITING_UPLOAD
  UPLOADED
  UNDER_REVIEW
  APPROVED
  RETURNED_FOR_REVISION
  SUPERSEDED
}

model User {
  id                  Int                  @id @default(autoincrement())
  loginId             String               @unique @map("login_id")
  passwordHash        String               @map("password_hash")
  role                UserRole
  prefix              String
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  gender              String?
  phone               String?
  cohortYear          Int?                 @map("cohort_year")
  classGroup          Int?                 @map("class_group")
  isActive            Boolean              @default(true) @map("is_active")
  sessions            AuthSession[]
  companyApplications CompanyApplication[]
  notifications       Notification[]
  supervisionVisits   SupervisionVisit[]
  supervisionGroupTeachers SupervisionGroupTeacher[]
  supervisionAppointmentStudents SupervisionAppointmentStudent[]
  supervisionAppointmentTeachers SupervisionAppointmentTeacher[]
  supervisionTravelTravellers SupervisionTravelTraveller[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([role, isActive])
  @@index([role, cohortYear, classGroup])
  @@map("users")
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model CooperativeCycle {
  id                   Int                    @id @default(autoincrement())
  term                 Int
  academicYear         Int                    @map("academic_year")
  cohortYear           Int                    @map("cohort_year")
  applicationStartDate DateTime               @map("application_start_date") @db.Date
  applicationEndDate   DateTime               @map("application_end_date") @db.Date
  internshipStartDate  DateTime               @map("internship_start_date") @db.Date
  internshipEndDate    DateTime               @map("internship_end_date") @db.Date
  status               CooperativeCycleStatus @default(OPEN_FOR_APPLICATION)
  note                 String?
  companyApplications  CompanyApplication[]
  supervisionVisits    SupervisionVisit[]
  supervisionRounds    SupervisionRound[]
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@unique([term, academicYear], name: "term_academicYear")
  @@map("cooperative_cycles")
}

model Company {
  id                  Int                  @id @default(autoincrement())
  name                String
  contactPerson       String               @map("contact_person")
  phone               String?
  email               String?
  addressNo           String               @map("address_no")
  moo                 String?
  soi                 String?
  street              String?
  subdistrict         String
  district            String
  province            String
  postalCode          String               @map("postal_code")
  latitude            Float?
  longitude           Float?
  travelNote          String?              @map("travel_note")
  isActive            Boolean              @default(true) @map("is_active")
  companyIdentityKey  String               @unique @map("company_identity_key")
  companyApplications CompanyApplication[]
  supervisionGroupCompanies SupervisionGroupCompany[]
  supervisionAppointments SupervisionAppointment[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("companies")
}

model CompanyApplication {
  id                     Int                      @id @default(autoincrement())
  studentUserId          Int                      @map("student_user_id")
  studentUser            User                     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  cooperativeCycleId     Int                      @map("cooperative_cycle_id")
  cooperativeCycle       CooperativeCycle         @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  companyId              Int                      @map("company_id")
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status                 CompanyApplicationStatus @default(SUBMITTED)
  applicationPosition    String?                  @map("application_position")
  applicationMethod      String                   @default("EMAIL") @map("application_method")
  appliedAt              DateTime                 @default(now()) @map("applied_at") @db.Date
  note                   String?
  outcomeAt              DateTime?                @map("outcome_at")
  recipientName          String?                  @map("recipient_name")
  letterAddress          String?                  @map("letter_address")
  internshipLocationName String?                  @map("internship_location_name")
  internshipLatitude     Float?                   @map("internship_latitude")
  internshipLongitude    Float?                   @map("internship_longitude")
  cooperativeRequest     CooperativeRequest?
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([studentUserId, cooperativeCycleId])
  @@index([status])
  @@map("company_applications")
}

model CooperativeRequest {
  id                         Int                      @id @default(autoincrement())
  companyApplicationId       Int                      @unique @map("company_application_id")
  companyApplication        CompanyApplication       @relation(fields: [companyApplicationId], references: [id], onDelete: Cascade)
  status                     CooperativeRequestStatus @default(SUBMITTED)
  companyName                String                   @map("company_name")
  internshipLocationName     String?                  @map("internship_location_name")
  position                   String?
  address                    String?
  province                   String?
  latitude                   Float?
  longitude                  Float?
  recipientName              String?                  @map("recipient_name")
  recipientPosition          String?                  @map("recipient_position")
  letterAddress              String?                  @map("letter_address")
  appliedAt                  DateTime?                @map("applied_at") @db.Date
  confirmedAt                DateTime                 @default(now()) @map("confirmed_at")
  returnedReason             String?                  @map("returned_reason")
  rejectedReason             String?                  @map("rejected_reason")
  studentNote                String?                  @map("student_note")
  letterFilePath             String?                  @map("letter_file_path")
  letterOriginalName         String?                  @map("letter_original_name")
  letterIssuedAt             DateTime?                @map("letter_issued_at")
  signedDocumentPath         String?                  @map("signed_document_path")
  signedDocumentOriginalName String?                  @map("signed_document_original_name")
  signedDocumentSubmittedAt  DateTime?                @map("signed_document_submitted_at")
  documents                  RequestDocument[]
  supervisionAppointmentStudents SupervisionAppointmentStudent[]
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  @@map("cooperative_requests")
}

model RequestDocument {
  id                   Int                @id @default(autoincrement())
  cooperativeRequestId Int                @map("cooperative_request_id")
  cooperativeRequest   CooperativeRequest @relation(fields: [cooperativeRequestId], references: [id], onDelete: Cascade)
  documentType         String             @default("ACCEPTANCE_LETTER") @map("document_type")
  fileName             String             @map("file_name")
  filePath             String             @map("file_path")
  fileSize             Int                @map("file_size")
  mimeType             String             @map("mime_type")
  status               DocumentStatus     @default(UPLOADED)
  version              Int                @default(1)
  reviewerNote         String?            @map("reviewer_note")
  reviewedAt           DateTime?          @map("reviewed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([cooperativeRequestId])
  @@map("request_documents")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model SupervisionVisit {
  id                 Int              @id @default(autoincrement())
  cooperativeCycleId Int              @map("cooperative_cycle_id")
  cooperativeCycle   CooperativeCycle @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  studentUserId      Int              @map("student_user_id")
  studentUser        User             @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  visitNo            Int              @default(1) @map("visit_no")
  visitDate          DateTime         @map("visit_date") @db.Date
  period             String           @default("MORNING")
  companyName        String           @map("company_name")
  companyAddress     String?          @map("company_address")
  supervisorName     String?          @map("supervisor_name")
  status             String           @default("PUBLISHED")
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([studentUserId, cooperativeCycleId])
  @@map("supervision_visits")
}

enum SupervisionRoundStatus {
  PLANNING
  PUBLISHED
  COMPLETED
}

enum SupervisionAppointmentStatus {
  DRAFT
  PUBLISHED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

model SupervisionRound {
  id                 Int                    @id @default(autoincrement())
  cooperativeCycleId Int                    @map("cooperative_cycle_id")
  cooperativeCycle   CooperativeCycle       @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  roundNo            Int                    @default(1) @map("round_no")
  name               String?
  status             SupervisionRoundStatus @default(PLANNING)
  groups             SupervisionGroup[]
  groupCompanies     SupervisionGroupCompany[]
  groupTeachers      SupervisionGroupTeacher[]
  appointments       SupervisionAppointment[]
  travelPlans        SupervisionTravelPlan[]
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@unique([cooperativeCycleId, roundNo], name: "cycle_roundNo")
  @@map("supervision_rounds")
}

model SupervisionGroup {
  id                 Int                        @id @default(autoincrement())
  supervisionRoundId Int                        @map("supervision_round_id")
  supervisionRound   SupervisionRound           @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  name               String
  note               String?
  companies          SupervisionGroupCompany[]
  teachers           SupervisionGroupTeacher[]
  appointments       SupervisionAppointment[]
  travelPlans        SupervisionTravelPlan[]
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@unique([supervisionRoundId, name], name: "round_group_name")
  @@map("supervision_groups")
}

model SupervisionGroupCompany {
  id                 Int              @id @default(autoincrement())
  supervisionRoundId Int              @map("supervision_round_id")
  supervisionRound   SupervisionRound @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int              @map("supervision_group_id")
  supervisionGroup   SupervisionGroup @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  companyId          Int              @map("company_id")
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@unique([supervisionRoundId, companyId], name: "round_company")
  @@index([supervisionGroupId])
  @@map("supervision_group_companies")
}

model SupervisionGroupTeacher {
  id                 Int              @id @default(autoincrement())
  supervisionRoundId Int              @map("supervision_round_id")
  supervisionRound   SupervisionRound @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int              @map("supervision_group_id")
  supervisionGroup   SupervisionGroup @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  teacherUserId      Int              @map("teacher_user_id")
  teacherUser        User             @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@unique([supervisionGroupId, teacherUserId], name: "group_teacher")
  @@unique([supervisionRoundId, teacherUserId], name: "round_teacher")
  @@map("supervision_group_teachers")
}

model SupervisionAppointment {
  id                 Int                          @id @default(autoincrement())
  supervisionRoundId Int                          @map("supervision_round_id")
  supervisionRound   SupervisionRound             @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int                          @map("supervision_group_id")
  supervisionGroup   SupervisionGroup             @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  companyId          Int                          @map("company_id")
  company            Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName        String                       @map("company_name")
  companyAddress     String?                      @map("company_address")
  province           String?
  latitude           Float?
  longitude          Float?
  scheduledDate      DateTime                     @map("scheduled_date") @db.Date
  period             String                       @default("MORNING")
  timeNote           String?                      @map("time_note")
  status             SupervisionAppointmentStatus @default(DRAFT)
  changeReason       String?                      @map("change_reason")
  cancelReason       String?                      @map("cancel_reason")
  publishedAt        DateTime?                    @map("published_at")
  students           SupervisionAppointmentStudent[]
  teachers           SupervisionAppointmentTeacher[]
  travelStops        SupervisionTravelStop[]
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@unique([supervisionRoundId, companyId], name: "round_appointment_company")
  @@index([supervisionGroupId])
  @@index([scheduledDate])
  @@index([status])
  @@map("supervision_appointments")
}

model SupervisionAppointmentStudent {
  id                   Int                    @id @default(autoincrement())
  appointmentId        Int                    @map("appointment_id")
  appointment          SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  studentUserId        Int                    @map("student_user_id")
  studentUser          User                   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  cooperativeRequestId Int?                   @map("cooperative_request_id")
  cooperativeRequest   CooperativeRequest?    @relation(fields: [cooperativeRequestId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now()) @map("created_at")

  @@unique([appointmentId, studentUserId], name: "appointment_student")
  @@map("supervision_appointment_students")
}

model SupervisionAppointmentTeacher {
  id            Int                    @id @default(autoincrement())
  appointmentId Int                    @map("appointment_id")
  appointment   SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  teacherUserId Int                    @map("teacher_user_id")
  teacherUser   User                   @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now()) @map("created_at")

  @@unique([appointmentId, teacherUserId], name: "appointment_teacher")
  @@map("supervision_appointment_teachers")
}

model SupervisionTravelPlan {
  id                 Int                          @id @default(autoincrement())
  supervisionRoundId Int                          @map("supervision_round_id")
  supervisionRound   SupervisionRound             @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int                          @map("supervision_group_id")
  supervisionGroup   SupervisionGroup             @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  travelDate         DateTime                     @map("travel_date") @db.Date
  startLocation      String                       @default("มหาวิทยาลัย") @map("start_location")
  fuelRate           Float                        @default(4.0) @map("fuel_rate")
  note               String?
  stops              SupervisionTravelStop[]
  travellers         SupervisionTravelTraveller[]
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@index([supervisionGroupId])
  @@index([supervisionRoundId])
  @@map("supervision_travel_plans")
}

model SupervisionTravelStop {
  id                     Int                    @id @default(autoincrement())
  travelPlanId           Int                    @map("travel_plan_id")
  travelPlan             SupervisionTravelPlan  @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  appointmentId          Int                    @map("appointment_id")
  appointment            SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sequence               Int                    @default(1)
  distanceKmFromPrevious Float                  @default(0) @map("distance_km_from_previous")
  createdAt              DateTime               @default(now()) @map("created_at")

  @@unique([travelPlanId, sequence], name: "plan_sequence")
  @@unique([travelPlanId, appointmentId], name: "plan_appointment")
  @@map("supervision_travel_stops")
}

model SupervisionTravelTraveller {
  id             Int                   @id @default(autoincrement())
  travelPlanId   Int                   @map("travel_plan_id")
  travelPlan     SupervisionTravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  teacherUserId  Int                   @map("teacher_user_id")
  teacherUser    User                  @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  perDiemRate    Float                 @default(300.0) @map("per_diem_rate")
  perDiemDays    Float                 @default(1.0) @map("per_diem_days")
  lodgingRate    Float                 @default(0.0) @map("lodging_rate")
  nights         Int                   @default(0)
  personsPerRoom Int                   @default(2) @map("persons_per_room")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([travelPlanId, teacherUserId], name: "plan_teacher")
  @@map("supervision_travel_travellers")
}
