generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum CooperativeCycleStatus {
  OPEN_FOR_APPLICATION
  APPLICATION_CLOSED
  IN_PROGRESS
  CLOSED
}

enum UserRole {
  STAFF
  TEACHER
  STUDENT
}

enum CompanyApplicationStatus {
  SUBMITTED
  AWAITING_RESPONSE
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  CONFIRMED
}

enum CooperativeRequestStatus {
  SUBMITTED
  STAFF_PROCESSING
  LETTER_READY
  DOCUMENT_UNDER_REVIEW
  RETURNED_FOR_REVISION
  PLACEMENT_CONFIRMED
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  WAITING_UPLOAD
  UPLOADED
  UNDER_REVIEW
  APPROVED
  RETURNED_FOR_REVISION
  SUPERSEDED
}

enum RequestLetterSource {
  GENERATED
  UPLOADED
}

model User {
  id                             Int                             @id @default(autoincrement())
  loginId                        String                          @unique @map("login_id")
  passwordHash                   String                          @map("password_hash")
  role                           UserRole
  prefix                         String
  firstName                      String                          @map("first_name")
  lastName                       String                          @map("last_name")
  // Used only by teacher records; student records are constrained to NULL in migration.
  gender                         String?
  phone                          String?
  cohortYear                     Int?                            @map("cohort_year")
  classGroup                     Int?                            @map("class_group")
  isActive                       Boolean                         @default(true) @map("is_active")
  mustChangePassword             Boolean                         @default(false) @map("must_change_password")
  sessions                       AuthSession[]
  companyApplications            CompanyApplication[]
  companyReviews                 CompanyReview[]
  cycleEnrollments               CooperativeCycleEnrollment[]
  notifications                  Notification[]
  supervisionVisits              SupervisionVisit[]
  supervisionGroupTeachers       SupervisionGroupTeacher[]
  supervisionAppointmentStudents SupervisionAppointmentStudent[]
  supervisionAppointmentTeachers SupervisionAppointmentTeacher[]
  supervisionTravelTravellers    SupervisionTravelTraveller[]
  studentEvaluationsGiven        StudentEvaluation[]             @relation("student_evaluation_teacher")
  studentEvaluationsReceived     StudentEvaluation[]             @relation("student_evaluation_student")
  companyEvaluations             CompanyEvaluation[]
  issuedRequestLetters           RequestLetterVersion[]          @relation("request_letter_issued_by")
  issuedSendingLetters           SendingLetterVersion[]          @relation("sending_letter_issued_by")
  uploadedRequestDocuments       RequestDocument[]               @relation("request_document_uploaded_by")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")

  @@index([role, isActive])
  @@index([role, cohortYear, classGroup])
  @@map("users")
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model CooperativeCycle {
  id                   Int                          @id @default(autoincrement())
  term                 Int
  academicYear         Int                          @map("academic_year")
  cohortYear           Int                          @map("cohort_year")
  applicationStartDate DateTime                     @map("application_start_date") @db.Date
  applicationEndDate   DateTime                     @map("application_end_date") @db.Date
  internshipStartDate  DateTime                     @map("internship_start_date") @db.Date
  internshipEndDate    DateTime                     @map("internship_end_date") @db.Date
  internshipHours      Int?                         @map("internship_hours")
  status               CooperativeCycleStatus       @default(OPEN_FOR_APPLICATION)
  note                 String?
  companyApplications  CompanyApplication[]
  enrollments          CooperativeCycleEnrollment[]
  supervisionVisits    SupervisionVisit[]
  supervisionRounds    SupervisionRound[]
  evaluationQuestions  EvaluationQuestion[]
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  @@unique([term, academicYear], name: "term_academicYear")
  @@map("cooperative_cycles")
}

model EvaluationQuestion {
  id                 Int              @id @default(autoincrement())
  cooperativeCycleId Int              @map("cooperative_cycle_id")
  cooperativeCycle   CooperativeCycle @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  evaluationType     String           @map("evaluation_type")
  scoreKey           String           @map("score_key")
  label              String
  sortOrder          Int              @map("sort_order")
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  answers            EvaluationAnswer[]
  @@unique([cooperativeCycleId, evaluationType, scoreKey])
  @@index([cooperativeCycleId, evaluationType, sortOrder])
  @@map("evaluation_questions")
}

model EvaluationAnswer {
  id                  Int                @id @default(autoincrement())
  questionId          Int                @map("question_id")
  question            EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentEvaluationId Int?               @map("student_evaluation_id")
  studentEvaluation   StudentEvaluation? @relation(fields: [studentEvaluationId], references: [id], onDelete: Cascade)
  companyEvaluationId Int?               @map("company_evaluation_id")
  companyEvaluation   CompanyEvaluation? @relation(fields: [companyEvaluationId], references: [id], onDelete: Cascade)
  score               Int?
  textValue           String?            @map("text_value")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  @@unique([questionId, studentEvaluationId])
  @@unique([questionId, companyEvaluationId])
  @@map("evaluation_answers")
}

model CooperativeCycleEnrollment {
  id                 Int              @id @default(autoincrement())
  cooperativeCycleId Int              @map("cooperative_cycle_id")
  cooperativeCycle   CooperativeCycle @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  studentUserId      Int              @map("student_user_id")
  studentUser        User             @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@unique([cooperativeCycleId, studentUserId], name: "cycle_student")
  @@index([studentUserId])
  @@map("cooperative_cycle_enrollments")
}

model Company {
  id                        Int                       @id @default(autoincrement())
  name                      String
  contactPerson             String                    @map("contact_person")
  phone                     String?
  email                     String?
  addressNo                 String                    @map("address_no")
  moo                       String?
  soi                       String?
  street                    String?
  subdistrict               String
  district                  String
  province                  String
  postalCode                String                    @map("postal_code")
  latitude                  Float?
  longitude                 Float?
  travelNote                String?                   @map("travel_note")
  isActive                  Boolean                   @default(true) @map("is_active")
  companyIdentityKey        String                    @unique @map("company_identity_key")
  companyApplications       CompanyApplication[]
  supervisionGroupCompanies SupervisionGroupCompany[]
  supervisionAppointments   SupervisionAppointment[]
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")

  @@map("companies")
}

model CompanyApplication {
  id                     Int                      @id @default(autoincrement())
  studentUserId          Int                      @map("student_user_id")
  studentUser            User                     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  cooperativeCycleId     Int                      @map("cooperative_cycle_id")
  cooperativeCycle       CooperativeCycle         @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  companyId              Int                      @map("company_id")
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status                 CompanyApplicationStatus @default(SUBMITTED)
  applicationPosition    String?                  @map("application_position")
  applicationMethod      String                   @default("EMAIL") @map("application_method")
  appliedAt              DateTime                 @default(now()) @map("applied_at") @db.Date
  note                   String?
  outcomeAt              DateTime?                @map("outcome_at")
  recipientName          String?                  @map("recipient_name")
  letterAddress          String?                  @map("letter_address")
  internshipLocationName String?                  @map("internship_location_name")
  internshipLatitude     Float?                   @map("internship_latitude")
  internshipLongitude    Float?                   @map("internship_longitude")
  cooperativeRequest     CooperativeRequest?
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([studentUserId, cooperativeCycleId])
  @@index([status])
  @@map("company_applications")
}

model CooperativeRequest {
  id                             Int                             @id @default(autoincrement())
  companyApplicationId           Int                             @unique @map("company_application_id")
  companyApplication             CompanyApplication              @relation(fields: [companyApplicationId], references: [id], onDelete: Cascade)
  status                         CooperativeRequestStatus        @default(SUBMITTED)
  companyName                    String                          @map("company_name")
  internshipLocationName         String?                         @map("internship_location_name")
  position                       String?
  address                        String?
  province                       String?
  latitude                       Float?
  longitude                      Float?
  recipientName                  String?                         @map("recipient_name")
  recipientPosition              String?                         @map("recipient_position")
  letterAddress                  String?                         @map("letter_address")
  appliedAt                      DateTime?                       @map("applied_at") @db.Date
  confirmedAt                    DateTime                        @default(now()) @map("confirmed_at")
  returnedReason                 String?                         @map("returned_reason")
  rejectedReason                 String?                         @map("rejected_reason")
  studentNote                    String?                         @map("student_note")
  letterFilePath                 String?                         @map("letter_file_path")
  letterOriginalName             String?                         @map("letter_original_name")
  letterIssuedAt                 DateTime?                       @map("letter_issued_at")
  signedDocumentPath             String?                         @map("signed_document_path")
  signedDocumentOriginalName     String?                         @map("signed_document_original_name")
  signedDocumentSubmittedAt      DateTime?                       @map("signed_document_submitted_at")
  documents                      RequestDocument[]
  letterVersions                 RequestLetterVersion[]
  requestLetterParticipations    RequestLetterParticipant[]
  primarySendingLetterVersions   SendingLetterVersion[]          @relation("sending_letter_primary_request")
  sendingLetterParticipations    SendingLetterParticipant[]
  supervisionAppointmentStudents SupervisionAppointmentStudent[]
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  companyReview                  CompanyReview?

  @@map("cooperative_requests")
}

model RequestDocument {
  id                   Int                @id @default(autoincrement())
  cooperativeRequestId Int                @map("cooperative_request_id")
  cooperativeRequest   CooperativeRequest @relation(fields: [cooperativeRequestId], references: [id], onDelete: Cascade)
  requestLetterVersionId Int?             @map("request_letter_version_id")
  requestLetterVersion   RequestLetterVersion? @relation(fields: [requestLetterVersionId], references: [id], onDelete: Cascade)
  uploadedByUserId       Int?              @map("uploaded_by_user_id")
  uploadedByUser         User?             @relation("request_document_uploaded_by", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  documentType         String             @default("ACCEPTANCE_LETTER") @map("document_type")
  fileName             String             @map("file_name")
  filePath             String             @map("file_path")
  fileSize             Int                @map("file_size")
  mimeType             String             @map("mime_type")
  status               DocumentStatus     @default(UPLOADED)
  version              Int                @default(1)
  reviewerNote         String?            @map("reviewer_note")
  reviewedAt           DateTime?          @map("reviewed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@unique([cooperativeRequestId, version], name: "request_document_version")
  @@unique([requestLetterVersionId, version], name: "request_letter_document_version")
  @@index([cooperativeRequestId])
  @@map("request_documents")
}

model RequestLetterVersion {
  id                   Int                 @id @default(autoincrement())
  cooperativeRequestId Int                 @map("cooperative_request_id")
  cooperativeRequest   CooperativeRequest  @relation(fields: [cooperativeRequestId], references: [id], onDelete: Cascade)
  participants         RequestLetterParticipant[]
  responseDocuments    RequestDocument[]
  version              Int                 @default(1)
  source               RequestLetterSource @default(GENERATED)
  fileName             String              @map("file_name")
  filePath             String              @map("file_path")
  fileSize             Int                 @map("file_size")
  sha256               String
  letterNumber         String?             @map("letter_number")
  issueDate            DateTime?           @map("issue_date") @db.Date
  templateVersion      String?             @map("template_version")
  signerName           String?             @map("signer_name")
  signerTitle          String?             @map("signer_title")
  issuedByUserId       Int?                @map("issued_by_user_id")
  issuedByUser         User?               @relation("request_letter_issued_by", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  isActive             Boolean             @default(true) @map("is_active")
  supersededAt         DateTime?           @map("superseded_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@unique([cooperativeRequestId, version], name: "request_letter_version")
  @@index([cooperativeRequestId, isActive])
  @@index([issuedByUserId])
  @@map("request_letter_versions")
}

model RequestLetterParticipant {
  id                     Int                  @id @default(autoincrement())
  requestLetterVersionId Int                  @map("request_letter_version_id")
  requestLetterVersion   RequestLetterVersion @relation(fields: [requestLetterVersionId], references: [id], onDelete: Cascade)
  cooperativeRequestId   Int                  @map("cooperative_request_id")
  cooperativeRequest     CooperativeRequest   @relation(fields: [cooperativeRequestId], references: [id], onDelete: Cascade)
  studentName            String               @map("student_name")
  createdAt              DateTime             @default(now()) @map("created_at")

  @@unique([requestLetterVersionId, cooperativeRequestId], name: "request_letter_participant")
  @@index([cooperativeRequestId])
  @@index([requestLetterVersionId])
  @@map("request_letter_participants")
}

model OfficialLetterSequence {
  year       Int      @id
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("official_letter_sequences")
}

model OfficialLetterNumber {
  id           Int      @id @default(autoincrement())
  year         Int
  letterNumber String   @unique @map("letter_number")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([year])
  @@map("official_letter_numbers")
}

model SendingLetterVersion {
  id                          Int                        @id @default(autoincrement())
  primaryCooperativeRequestId Int                        @map("primary_cooperative_request_id")
  primaryCooperativeRequest   CooperativeRequest         @relation("sending_letter_primary_request", fields: [primaryCooperativeRequestId], references: [id], onDelete: Cascade)
  participants                SendingLetterParticipant[]
  version                     Int                        @default(1)
  fileName                    String                     @map("file_name")
  filePath                    String                     @map("file_path")
  fileSize                    Int                        @map("file_size")
  sha256                      String
  letterNumber                String                     @map("letter_number")
  issueDate                   DateTime                   @map("issue_date") @db.Date
  referenceLetterNumber       String                     @map("reference_letter_number")
  referenceIssueDate          DateTime                   @map("reference_issue_date") @db.Date
  templateVersion             String                     @default("v1") @map("template_version")
  signerName                  String                     @map("signer_name")
  signerTitle                 String                     @map("signer_title")
  issuedByUserId              Int?                       @map("issued_by_user_id")
  issuedByUser                User?                      @relation("sending_letter_issued_by", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  isActive                    Boolean                    @default(true) @map("is_active")
  supersededAt                DateTime?                  @map("superseded_at")
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")

  @@unique([primaryCooperativeRequestId, version], name: "sending_letter_version")
  @@index([primaryCooperativeRequestId, isActive])
  @@index([issuedByUserId])
  @@map("sending_letter_versions")
}

model SendingLetterParticipant {
  id                     Int                  @id @default(autoincrement())
  sendingLetterVersionId Int                  @map("sending_letter_version_id")
  sendingLetterVersion   SendingLetterVersion @relation(fields: [sendingLetterVersionId], references: [id], onDelete: Cascade)
  cooperativeRequestId   Int                  @map("cooperative_request_id")
  cooperativeRequest     CooperativeRequest   @relation(fields: [cooperativeRequestId], references: [id], onDelete: Cascade)
  createdAt              DateTime             @default(now()) @map("created_at")

  @@unique([sendingLetterVersionId, cooperativeRequestId], name: "sending_letter_participant")
  @@index([cooperativeRequestId])
  @@map("sending_letter_participants")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model SupervisionVisit {
  id                 Int              @id @default(autoincrement())
  cooperativeCycleId Int              @map("cooperative_cycle_id")
  cooperativeCycle   CooperativeCycle @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  studentUserId      Int              @map("student_user_id")
  studentUser        User             @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  visitNo            Int              @default(1) @map("visit_no")
  visitDate          DateTime         @map("visit_date") @db.Date
  period             String           @default("MORNING")
  companyName        String           @map("company_name")
  companyAddress     String?          @map("company_address")
  supervisorName     String?          @map("supervisor_name")
  status             String           @default("PUBLISHED")
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([studentUserId, cooperativeCycleId])
  @@map("supervision_visits")
}

enum SupervisionRoundStatus {
  PUBLISHED
  COMPLETED
}

enum SupervisionAppointmentStatus {
  PUBLISHED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

model SupervisionRound {
  id                 Int                       @id @default(autoincrement())
  cooperativeCycleId Int                       @map("cooperative_cycle_id")
  cooperativeCycle   CooperativeCycle          @relation(fields: [cooperativeCycleId], references: [id], onDelete: Cascade)
  roundNo            Int                       @default(1) @map("round_no")
  name               String?
  status             SupervisionRoundStatus    @default(PUBLISHED)
  groups             SupervisionGroup[]
  groupCompanies     SupervisionGroupCompany[]
  groupTeachers      SupervisionGroupTeacher[]
  appointments       SupervisionAppointment[]
  travelPlans        SupervisionTravelPlan[]
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@unique([cooperativeCycleId, roundNo], name: "cycle_roundNo")
  @@map("supervision_rounds")
}

model SupervisionGroup {
  id                 Int                       @id @default(autoincrement())
  supervisionRoundId Int                       @map("supervision_round_id")
  supervisionRound   SupervisionRound          @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  name               String
  note               String?
  companies          SupervisionGroupCompany[]
  teachers           SupervisionGroupTeacher[]
  appointments       SupervisionAppointment[]
  travelPlans        SupervisionTravelPlan[]
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@unique([supervisionRoundId, name], name: "round_group_name")
  @@map("supervision_groups")
}

model SupervisionGroupCompany {
  id                 Int              @id @default(autoincrement())
  supervisionRoundId Int              @map("supervision_round_id")
  supervisionRound   SupervisionRound @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int              @map("supervision_group_id")
  supervisionGroup   SupervisionGroup @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  companyId          Int              @map("company_id")
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@unique([supervisionRoundId, companyId], name: "round_company")
  @@index([supervisionGroupId])
  @@map("supervision_group_companies")
}

model SupervisionGroupTeacher {
  id                 Int              @id @default(autoincrement())
  supervisionRoundId Int              @map("supervision_round_id")
  supervisionRound   SupervisionRound @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int              @map("supervision_group_id")
  supervisionGroup   SupervisionGroup @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  teacherUserId      Int              @map("teacher_user_id")
  teacherUser        User             @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@unique([supervisionGroupId, teacherUserId], name: "group_teacher")
  @@unique([supervisionRoundId, teacherUserId], name: "round_teacher")
  @@map("supervision_group_teachers")
}

model SupervisionAppointment {
  id                 Int                             @id @default(autoincrement())
  supervisionRoundId Int                             @map("supervision_round_id")
  supervisionRound   SupervisionRound                @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int                             @map("supervision_group_id")
  supervisionGroup   SupervisionGroup                @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  companyId          Int                             @map("company_id")
  company            Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName        String                          @map("company_name")
  companyAddress     String?                         @map("company_address")
  province           String?
  latitude           Float?
  longitude          Float?
  scheduledDate      DateTime                        @map("scheduled_date") @db.Date
  period             String                          @default("MORNING")
  timeNote           String?                         @map("time_note")
  status             SupervisionAppointmentStatus    @default(PUBLISHED)
  changeReason       String?                         @map("change_reason")
  cancelReason       String?                         @map("cancel_reason")
  publishedAt        DateTime?                       @map("published_at")
  evaluationNote     String?                         @map("evaluation_note")
  evaluatedAt        DateTime?                       @map("evaluated_at")
  students           SupervisionAppointmentStudent[]
  teachers           SupervisionAppointmentTeacher[]
  travelStops        SupervisionTravelStop[]
  studentEvaluations StudentEvaluation[]
  companyEvaluations CompanyEvaluation[]
  photos             SupervisionAppointmentPhoto[]
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")

  @@unique([supervisionRoundId, companyId], name: "round_appointment_company")
  @@index([supervisionGroupId])
  @@index([scheduledDate])
  @@index([status])
  @@map("supervision_appointments")
}

model SupervisionAppointmentPhoto {
  id            Int                    @id @default(autoincrement())
  appointmentId Int                    @map("appointment_id")
  appointment   SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  originalName  String                 @map("original_name")
  storageName   String                 @map("storage_name")
  mimeType      String                 @map("mime_type")
  fileSize      Int                    @map("file_size")
  createdAt     DateTime               @default(now()) @map("created_at")

  @@index([appointmentId])
  @@map("supervision_appointment_photos")
}

model SupervisionAppointmentStudent {
  id                   Int                    @id @default(autoincrement())
  appointmentId        Int                    @map("appointment_id")
  appointment          SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  studentUserId        Int                    @map("student_user_id")
  studentUser          User                   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  cooperativeRequestId Int?                   @map("cooperative_request_id")
  cooperativeRequest   CooperativeRequest?    @relation(fields: [cooperativeRequestId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now()) @map("created_at")

  @@unique([appointmentId, studentUserId], name: "appointment_student")
  @@map("supervision_appointment_students")
}

model SupervisionAppointmentTeacher {
  id            Int                    @id @default(autoincrement())
  appointmentId Int                    @map("appointment_id")
  appointment   SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  teacherUserId Int                    @map("teacher_user_id")
  teacherUser   User                   @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now()) @map("created_at")

  @@unique([appointmentId, teacherUserId], name: "appointment_teacher")
  @@map("supervision_appointment_teachers")
}

model StudentEvaluation {
  id                  Int                    @id @default(autoincrement())
  appointmentId       Int                    @map("appointment_id")
  appointment         SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  studentUserId       Int                    @map("student_user_id")
  studentUser         User                   @relation("student_evaluation_student", fields: [studentUserId], references: [id], onDelete: Cascade)
  teacherUserId       Int                    @map("teacher_user_id")
  teacherUser         User                   @relation("student_evaluation_teacher", fields: [teacherUserId], references: [id], onDelete: Cascade)
  responsibilityScore Int?                   @map("responsibility_score")
  disciplineScore     Int?                   @map("discipline_score")
  communicationScore  Int?                   @map("communication_score")
  knowledgeScore      Int?                   @map("knowledge_score")
  workQualityScore    Int?                   @map("work_quality_score")
  problemSolvingScore Int?                   @map("problem_solving_score")
  strengths           String?
  problems            String?
  recommendations     String?
  followUp            String?                @map("follow_up")
  submittedAt         DateTime               @default(now()) @map("submitted_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  answers             EvaluationAnswer[]

  @@unique([appointmentId, studentUserId, teacherUserId], name: "appointment_student_teacher")
  @@index([teacherUserId])
  @@index([studentUserId])
  @@map("student_evaluations")
}

/// Singleton settings used by the server when it generates official letters.
/// The signature stays in private storage; only its filesystem path is stored.
model DocumentSettings {
  id            Int      @id
  signerName    String?  @map("signer_name")
  signerTitle   String?  @map("signer_title")
  signaturePath String?  @map("signature_path")
  requestLetterSamplePath String? @map("request_letter_sample_path")
  requestLetterSampleName String? @map("request_letter_sample_name")
  sendingLetterSamplePath String? @map("sending_letter_sample_path")
  sendingLetterSampleName String? @map("sending_letter_sample_name")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("document_settings")
}

model CompanyReview {
  id                   Int                @id @default(autoincrement())
  studentUserId        Int                @map("student_user_id")
  studentUser          User               @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  cooperativeRequestId Int                @unique @map("cooperative_request_id")
  cooperativeRequest   CooperativeRequest @relation(fields: [cooperativeRequestId], references: [id], onDelete: Cascade)
  rating               Int
  comment              String
  status               String             @default("PENDING")
  reviewerNote         String?            @map("reviewer_note")
  reviewedAt           DateTime?          @map("reviewed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  @@unique([studentUserId, cooperativeRequestId])
  @@map("company_reviews")
}

model CompanyEvaluation {
  id                       Int                    @id @default(autoincrement())
  appointmentId            Int                    @map("appointment_id")
  appointment              SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  teacherUserId            Int                    @map("teacher_user_id")
  teacherUser              User                   @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  workAlignmentScore       Int?                   @map("work_alignment_score")
  workScopeScore           Int?                   @map("work_scope_score")
  learningOpportunityScore Int?                   @map("learning_opportunity_score")
  supervisorReadinessScore Int?                   @map("supervisor_readiness_score")
  studentSupportScore      Int?                   @map("student_support_score")
  environmentScore         Int?                   @map("environment_score")
  safetyScore              Int?                   @map("safety_score")
  resourcesScore           Int?                   @map("resources_score")
  welfareScore             Int?                   @map("welfare_score")
  travelScore              Int?                   @map("travel_score")
  transportScore           Int?                   @map("transport_score")
  accommodationScore       Int?                   @map("accommodation_score")
  coordinationScore        Int?                   @map("coordination_score")
  observations             String?
  companyNeeds             String?                @map("company_needs")
  problems                 String?
  recommendations          String?
  futureRecommendation     String?                @map("future_recommendation")
  submittedAt              DateTime               @default(now()) @map("submitted_at")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  answers                  EvaluationAnswer[]

  @@unique([appointmentId, teacherUserId], name: "appointment_teacher_company_evaluation")
  @@index([teacherUserId])
  @@map("company_evaluations")
}

model SupervisionTravelPlan {
  id                 Int                          @id @default(autoincrement())
  supervisionRoundId Int                          @map("supervision_round_id")
  supervisionRound   SupervisionRound             @relation(fields: [supervisionRoundId], references: [id], onDelete: Cascade)
  supervisionGroupId Int                          @map("supervision_group_id")
  supervisionGroup   SupervisionGroup             @relation(fields: [supervisionGroupId], references: [id], onDelete: Cascade)
  travelDate         DateTime                     @map("travel_date") @db.Date
  startLocation      String                       @default("มหาวิทยาลัย") @map("start_location")
  fuelRate           Float                        @default(4.0) @map("fuel_rate")
  lodgingRate        Float                        @default(0.0) @map("lodging_rate")
  lodgingNights      Int                          @default(0) @map("lodging_nights")
  lodgingRooms       Int                          @default(0) @map("lodging_rooms")
  note               String?
  stops              SupervisionTravelStop[]
  travellers         SupervisionTravelTraveller[]
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@index([supervisionGroupId])
  @@index([supervisionRoundId])
  @@map("supervision_travel_plans")
}

model SupervisionTravelStop {
  id                     Int                    @id @default(autoincrement())
  travelPlanId           Int                    @map("travel_plan_id")
  travelPlan             SupervisionTravelPlan  @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  appointmentId          Int                    @map("appointment_id")
  appointment            SupervisionAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sequence               Int                    @default(1)
  distanceKmFromPrevious Float                  @default(0) @map("distance_km_from_previous")
  createdAt              DateTime               @default(now()) @map("created_at")

  @@unique([travelPlanId, sequence], name: "plan_sequence")
  @@unique([travelPlanId, appointmentId], name: "plan_appointment")
  @@map("supervision_travel_stops")
}

model SupervisionTravelTraveller {
  id             Int                   @id @default(autoincrement())
  travelPlanId   Int                   @map("travel_plan_id")
  travelPlan     SupervisionTravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  teacherUserId  Int                   @map("teacher_user_id")
  teacherUser    User                  @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  perDiemRate    Float                 @default(300.0) @map("per_diem_rate")
  perDiemDays    Float                 @default(1.0) @map("per_diem_days")
  lodgingRate    Float                 @default(0.0) @map("lodging_rate")
  nights         Int                   @default(0)
  personsPerRoom Int                   @default(2) @map("persons_per_room")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([travelPlanId, teacherUserId], name: "plan_teacher")
  @@map("supervision_travel_travellers")
}
