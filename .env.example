DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres"
# Supabase session-pooler URL for Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"
PERSISTENT_STORAGE_DIR=./uploads
# Only needed when starting the optional local-db Compose profile.
POSTGRES_USER=cwie
POSTGRES_PASSWORD=change-this-before-production
POSTGRES_DB=cwie_dev
POSTGRES_PORT=5432
APP_PORT=3000

# Request letter signer configuration (server-only, required for generating signed request letters)
# DOCUMENT_SIGNER_NAME: Full name of the authorized signer
DOCUMENT_SIGNER_NAME=
# DOCUMENT_SIGNER_TITLE: Official title lines of the signer (supports multi-line separated by \n)
DOCUMENT_SIGNER_TITLE=
# DOCUMENT_SIGNER_SIGNATURE_PATH: Authorized signature PNG used by every generated official document (must NOT be under public/)
DOCUMENT_SIGNER_SIGNATURE_PATH=/run/signatures/authorized-dean.png
# Host directory mounted into container for signature file (optional, mounted read-only to /run/signatures)
DOCUMENT_SIGNER_SIGNATURE_DIR=./signatures
